rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string &&
        id.size() >= 2 &&
        id.size() <= 128 &&
        id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'herzz@smkn2banjar-jabar.sch.id' &&
        request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isBootstrappedAdmin();
    }

    function isValidVillage(village) {
      return village in [
        'Desa Bangunharja',
        'Desa Cisaga',
        'Desa Danasari',
        'Desa Girimukti',
        'Desa Karyamulya',
        'Desa Kepel',
        'Desa Mekarmukti',
        'Desa Sidamulya',
        'Desa Sukahurip',
        'Desa Tanjungjaya',
        'Desa Wangunjaya'
      ];
    }

    function isValidContactShape(data, contactId) {
      return data.keys().hasAll([
          'id',
          'name',
          'email',
          'whatsapp',
          'subject',
          'message',
          'status',
          'created_at'
        ]) &&
        data.keys().hasOnly([
          'id',
          'name',
          'email',
          'whatsapp',
          'subject',
          'message',
          'status',
          'created_at'
        ]) &&
        data.id is string &&
        data.id == contactId &&
        data.id.size() >= 4 &&
        data.id.size() <= 80 &&
        data.name is string &&
        data.name.size() >= 2 &&
        data.name.size() <= 80 &&
        data.email is string &&
        data.email.size() >= 5 &&
        data.email.size() <= 120 &&
        data.email.matches('^[^\\s@<>]+@[^\\s@<>]+\\.[^\\s@<>]+$') &&
        data.whatsapp is string &&
        data.whatsapp.size() <= 20 &&
        data.subject is string &&
        data.subject.size() >= 2 &&
        data.subject.size() <= 120 &&
        data.message is string &&
        data.message.size() >= 2 &&
        data.message.size() <= 1500 &&
        data.status in ['unread', 'read', 'replied'] &&
        data.created_at is timestamp;
    }

    function isValidContactCreate(data, contactId) {
      return isValidContactShape(data, contactId) &&
        data.status == 'unread' &&
        data.created_at == request.time;
    }

    function isValidContactStatusUpdate(data, prev, contactId) {
      return isValidContactShape(data, contactId) &&
        data.diff(prev).affectedKeys().hasOnly(['status']) &&
        data.status in ['unread', 'read', 'replied'] &&
        data.id == prev.id &&
        data.name == prev.name &&
        data.email == prev.email &&
        data.whatsapp == prev.whatsapp &&
        data.subject == prev.subject &&
        data.message == prev.message &&
        data.created_at == prev.created_at;
    }

    function isValidUmkmListingShape(data, listingId) {
      return data.keys().hasAll([
          'id',
          'businessName',
          'ownerName',
          'productName',
          'category',
          'village',
          'whatsapp',
          'tier',
          'status',
          'price',
          'unitLabel',
          'shortDescription',
          'fullDescription',
          'image',
          'galleryImages',
          'variants',
          'createdAt',
          'serverCreatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'businessName',
          'ownerName',
          'productName',
          'category',
          'village',
          'whatsapp',
          'tier',
          'status',
          'price',
          'unitLabel',
          'shortDescription',
          'fullDescription',
          'image',
          'galleryImages',
          'variants',
          'createdAt',
          'serverCreatedAt'
        ]) &&
        data.id is string &&
        data.id == listingId &&
        data.id.size() >= 2 &&
        data.id.size() <= 80 &&
        data.businessName is string &&
        data.businessName.size() >= 3 &&
        data.businessName.size() <= 100 &&
        data.ownerName is string &&
        data.ownerName.size() >= 3 &&
        data.ownerName.size() <= 80 &&
        data.productName is string &&
        data.productName.size() >= 3 &&
        data.productName.size() <= 120 &&
        data.category in ['Kuliner', 'Kerajinan', 'Agribisnis', 'Busana'] &&
        data.village is string &&
        isValidVillage(data.village) &&
        data.whatsapp is string &&
        data.whatsapp.size() >= 10 &&
        data.whatsapp.size() <= 15 &&
        data.whatsapp.matches('^[0-9]+$') &&
        data.tier in ['premium', 'reguler'] &&
        data.status in ['Aktif', 'Menunggu Verifikasi', 'Nonaktif'] &&
        data.price is number &&
        data.price >= 1000 &&
        data.price <= 100000000 &&
        data.unitLabel is string &&
        data.unitLabel.size() >= 2 &&
        data.unitLabel.size() <= 80 &&
        data.shortDescription is string &&
        data.shortDescription.size() >= 10 &&
        data.shortDescription.size() <= 300 &&
        data.fullDescription is string &&
        data.fullDescription.size() >= 10 &&
        data.fullDescription.size() <= 1000 &&
        data.image is string &&
        data.image.size() >= 5 &&
        data.image.size() <= 260000 &&
        data.galleryImages is list &&
        data.galleryImages.size() <= 6 &&
        (data.galleryImages.size() == 0 || (data.galleryImages[0] is string && data.galleryImages[0].size() <= 260000)) &&
        data.variants is list &&
        data.variants.size() >= 1 &&
        data.variants.size() <= 25 &&
        data.variants[0] is map &&
        'label' in data.variants[0] &&
        data.variants[0].label is string &&
        data.variants[0].label.size() >= 2 &&
        data.variants[0].label.size() <= 80 &&
        'price' in data.variants[0] &&
        data.variants[0].price is number &&
        data.variants[0].price >= 1000 &&
        data.createdAt is string &&
        data.createdAt.size() >= 4 &&
        data.createdAt.size() <= 40 &&
        data.serverCreatedAt is timestamp;
    }

    function isValidUmkmListingCreate(data, listingId) {
      return isValidUmkmListingShape(data, listingId) &&
        data.serverCreatedAt == request.time;
    }

    function isValidUmkmListingUpdate(data, prev, listingId) {
      return isValidUmkmListingShape(data, listingId) &&
        data.id == prev.id &&
        data.createdAt == prev.createdAt &&
        data.serverCreatedAt == prev.serverCreatedAt &&
        (
          data.diff(prev).affectedKeys().hasOnly(['tier']) ||
          data.diff(prev).affectedKeys().hasOnly(['status']) ||
          data.diff(prev).affectedKeys().hasOnly([
            'businessName',
            'ownerName',
            'productName',
            'category',
            'village',
            'whatsapp',
            'tier',
            'status',
            'price',
            'unitLabel',
            'shortDescription',
            'fullDescription',
            'image',
            'galleryImages',
            'variants'
          ])
        );
    }


    match /contacts/{contactId} {
      allow get: if isValidId(contactId) && isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isValidId(contactId) && isValidContactCreate(incoming(), contactId);
      allow update: if isAdmin() &&
        isValidId(contactId) &&
        isValidContactStatusUpdate(incoming(), existing(), contactId);
      allow delete: if isAdmin() && isValidId(contactId);
    }

    match /umkm_listings/{listingId} {
      allow get: if isValidId(listingId) && (existing().status == 'Aktif' || isAdmin());
      allow list: if resource.data.status == 'Aktif' || isBootstrappedAdmin();
      allow create: if isValidId(listingId) &&
        isValidUmkmListingCreate(incoming(), listingId) &&
        (
          (incoming().tier == 'reguler' && incoming().status == 'Menunggu Verifikasi') ||
          isAdmin()
        );
      allow update: if isAdmin() &&
        isValidId(listingId) &&
        isValidUmkmListingUpdate(incoming(), existing(), listingId);
      allow delete: if isAdmin() && isValidId(listingId);
    }

    match /admins/{userId} {
      allow read, write: if false;
    }
  }
}
