{
  "entities": {
    "UmkmListing": {
      "title": "UmkmListing",
      "description": "Data profil usaha dan katalog produk/layanan UMKM Kecamatan Cisaga",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "businessName": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100
        },
        "ownerName": {
          "type": "string",
          "minLength": 3,
          "maxLength": 80
        },
        "productName": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "enum": ["Kuliner", "Kerajinan", "Agribisnis", "Busana"]
        },
        "village": {
          "type": "string",
          "enum": [
            "Desa Bangunharja",
            "Desa Cisaga",
            "Desa Danasari",
            "Desa Girimukti",
            "Desa Karyamulya",
            "Desa Kepel",
            "Desa Mekarmukti",
            "Desa Sidamulya",
            "Desa Sukahurip",
            "Desa Tanjungjaya",
            "Desa Wangunjaya"
          ]
        },
        "whatsapp": {
          "type": "string",
          "minLength": 10,
          "maxLength": 15,
          "pattern": "^[0-9]+$"
        },
        "tier": {
          "type": "string",
          "enum": ["premium", "reguler"]
        },
        "status": {
          "type": "string",
          "enum": ["Aktif", "Menunggu Verifikasi", "Nonaktif"]
        },
        "price": {
          "type": "number"
        },
        "unitLabel": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "shortDescription": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300
        },
        "fullDescription": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1000
        },
        "image": {
          "type": "string",
          "minLength": 5,
          "maxLength": 260000
        },
        "galleryImages": {
          "type": "array"
        },
        "variants": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40
        },
        "serverCreatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "businessName",
        "ownerName",
        "productName",
        "category",
        "village",
        "whatsapp",
        "tier",
        "status",
        "price",
        "unitLabel",
        "shortDescription",
        "fullDescription",
        "image",
        "galleryImages",
        "variants",
        "createdAt",
        "serverCreatedAt"
      ]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Pesan pengunjung dari formulir Hubungi Saya yang tersimpan permanen untuk kotak masuk Panel Admin",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 4,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 120,
          "pattern": "^[^\\s@<>]+@[^\\s@<>]+\\.[^\\s@<>]+$"
        },
        "whatsapp": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20
        },
        "subject": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "message": {
          "type": "string",
          "minLength": 2,
          "maxLength": 1500
        },
        "status": {
          "type": "string",
          "enum": ["unread", "read", "replied"]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "whatsapp",
        "subject",
        "message",
        "status",
        "created_at"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Akun pengelola admin terotorisasi untuk Panel Admin CISAGA HUB",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "role", "createdAt"]
    }
  },
  "firestore": {
    "/umkm_listings/{listingId}": {
      "schema": {
        "$ref": "#/entities/UmkmListing"
      },
      "description": "Katalog dan direktori usaha UMKM Kecamatan Cisaga"
    },
    "/contacts/{contactId}": {
      "schema": {
        "$ref": "#/entities/ContactMessage"
      },
      "description": "Pesan masuk dari formulir Hubungi Saya"
    },
    "/admins/{userId}": {
      "schema": {
        "$ref": "#/entities/AdminUser"
      },
      "description": "Daftar administrator terverifikasi"
    }
  }
}
